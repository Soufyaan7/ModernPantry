---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  product: CollectionEntry<'kitchen-finds'>;
}

const { product } = Astro.props;
const { badge, originalPrice, price, scores, reviewCount, soldCount } = product.data;

const avgRating = scores 
  ? (scores.quality + scores.value + scores.easeOfUse + scores.design) / 4 
  : 5;

const discount = originalPrice 
  ? Math.round(((originalPrice - price) / originalPrice) * 100) 
  : 0;

const badgeColor = badge ? 'bg-brand-orange' : 'bg-brand-green';
---

<a href={`/kitchen-finds/${product.id.replace(/\.mdx?$/, '')}`} class="flex flex-col h-full bg-white rounded-2xl p-5 group premium-shadow border border-gray-100 hover:border-brand-green/30 transition-all duration-300 relative overflow-hidden">
  
  <!-- Badges -->
  {discount > 0 && (
    <div class="absolute top-3 left-3 bg-red-500 text-white text-[10px] font-bold px-2 py-1 rounded-lg z-20">
      -{discount}%
    </div>
  )}

  <div class={`absolute top-0 right-0 ${badgeColor} text-white text-[10px] font-bold px-3 py-1 rounded-bl-lg uppercase tracking-wider z-10`}>
    {badge || "Review"}
  </div>

  <div class="relative w-full aspect-[4/3] mb-5 overflow-hidden rounded-xl bg-gray-50">
    <Image width={400} height={300} src={product.data.image || "https://images.unsplash.com/photo-1593618998160-e34014e67546?w=400&q=80"} alt={product.data.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
  </div>
  
  <div class="text-center flex-grow flex flex-col">
    <!-- Rating -->
    <div class="flex flex-col items-center mb-2">
      <div class="flex items-center gap-1">
        <div class="flex text-yellow-400">
          {[...Array(5)].map((_, i) => (
            <svg class={`w-3.5 h-3.5 ${i < Math.round(avgRating) ? 'fill-current' : 'fill-gray-300'}`} viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <span class="text-[11px] font-bold text-gray-500">({reviewCount?.toLocaleString() || 0})</span>
      </div>
      <span class="text-[10px] text-gray-400 mt-0.5">{soldCount?.toLocaleString() || 0}+ sold</span>
    </div>

    <h3 class="font-sans font-semibold text-sm leading-snug mb-3 line-clamp-2 text-brand-text group-hover:text-brand-orange transition-colors">
      {product.data.title}
    </h3>
    
    <div class="mt-auto">
      <div class="flex items-center justify-center gap-2 mb-4">
        {originalPrice && (
          <span class="text-gray-400 line-through text-xs">${originalPrice.toFixed(2)}</span>
        )}
        <span class="text-brand-orange font-bold text-xl">${price.toFixed(2)}</span>
      </div>
      
      <span class="w-full block text-center bg-brand-bg text-brand-text border border-gray-200 group-hover:bg-brand-orange group-hover:text-white group-hover:border-brand-orange font-bold py-2.5 px-4 rounded-xl text-sm transition-all duration-300 shadow-sm">
        Read Review
      </span>
    </div>
  </div>
</a>
