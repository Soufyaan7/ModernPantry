---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  product: CollectionEntry<'kitchen-finds'>;
}

const { product } = Astro.props;
---

<a href={`/kitchen-finds/${product.id.replace(/\.mdx?$/, '')}`} class="flex flex-col h-full bg-white rounded-2xl p-5 group premium-shadow border border-gray-100 hover:border-brand-green/30 transition-all duration-300 relative overflow-hidden">
  
  <!-- Badge -->
  <div class="absolute top-0 right-0 bg-brand-green text-white text-[10px] font-bold px-3 py-1 rounded-bl-lg uppercase tracking-wider z-10">
    Review
  </div>

  <div class="relative w-full aspect-square mb-5 flex items-center justify-center p-4 bg-gray-50 rounded-xl group-hover:bg-brand-orange/5 transition-colors duration-300">
    <Image width={400} height={400} src={product.data.image || "https://images.unsplash.com/photo-1593618998160-e34014e67546?w=400&q=80"} alt={product.data.title} class="max-h-full object-contain transition-transform duration-500 group-hover:scale-110 drop-shadow-md" />
  </div>
  
  <div class="text-center flex-grow flex flex-col">
    <h3 class="font-sans font-semibold text-sm leading-snug mb-3 line-clamp-2 text-brand-text group-hover:text-brand-orange transition-colors">
      {product.data.title}
    </h3>
    
    <div class="mt-auto">
      <div class="flex items-center justify-center gap-2 mb-4">
        <span class="text-brand-orange font-bold text-xl">${product.data.price.toFixed(2)}</span>
        {product.data.shippingType && (
          <span class="bg-green-100 text-green-800 text-[10px] font-bold px-2 py-0.5 rounded-full uppercase">
            {product.data.shippingType}
          </span>
        )}
      </div>
      
      <span class="w-full block text-center bg-brand-bg text-brand-text border border-gray-200 group-hover:bg-brand-orange group-hover:text-white group-hover:border-brand-orange font-bold py-2.5 px-4 rounded-xl text-sm transition-all duration-300 shadow-sm">
        Read Review
      </span>
    </div>
  </div>
</a>
