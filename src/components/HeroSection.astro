---
import { getCollection } from 'astro:content';

const recipes = await getCollection('recipes');
const products = await getCollection('kitchen-finds');

// Fix #3: Match ID without extension
const featuredProduct = products.find(p => p.id === 'professional-chef-knives') 
  || products.find(p => p.data.featured) 
  || products[0];

// Fix #4: Show newest featured recipe, sorted by publishDate descending
const featuredRecipe = recipes
  .filter(r => r.data.featured)
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())[0]
  || recipes.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())[0];

const recipeSlug = featuredRecipe.id.replace(/\.mdx?$/, '');
---

<section class="mt-8 mb-16 grid grid-cols-1 lg:grid-cols-2 gap-8">
  
  <!-- Left: Featured Recipe -->
  <a href={`/recipes/${recipeSlug}`} class="relative rounded-[2rem] overflow-hidden h-[350px] sm:h-[450px] lg:h-[500px] group cursor-pointer premium-shadow">
    <div class="absolute inset-0 bg-cover bg-center transition-transform duration-1000 group-hover:scale-110" style={`background-image: url('${featuredRecipe.data.image}');`}></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
    
    <div class="absolute bottom-0 left-0 p-6 sm:p-10 w-full z-10">
      <div class="inline-block bg-brand-orange text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-4 shadow-md">
        {featuredRecipe.data.category}
      </div>
      <h2 class="text-white text-2xl sm:text-4xl md:text-5xl font-serif font-bold leading-tight mb-3 sm:mb-4 w-[95%] sm:w-[90%] drop-shadow-md">
        {featuredRecipe.data.title}
      </h2>
      <p class="text-white/90 text-sm sm:text-lg font-sans font-medium border-t border-white/20 pt-3 sm:pt-4 mt-2 line-clamp-2">
        {featuredRecipe.data.description}
      </p>
    </div>
    
    <!-- Hover Overlay Icon -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-16 h-16 bg-white/20 backdrop-blur-md rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
      <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
    </div>
  </a>

  <!-- Right: Featured Product Highlight -->
  <a href={`/kitchen-finds/${featuredProduct.id.replace(/\.mdx?$/, '')}`} class="relative rounded-[2rem] overflow-hidden h-auto lg:h-[500px] flex group premium-shadow bg-brand-green">
    <!-- Decorative background elements -->
    <div class="absolute inset-0 opacity-10" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
    <div class="absolute top-0 right-0 w-full lg:w-1/2 h-full bg-gradient-to-t lg:bg-gradient-to-l from-black/20 to-transparent"></div>
    
    <div class="relative z-10 w-full h-full flex flex-col lg:flex-row items-center p-6 sm:p-8 md:p-12 gap-8">
      <!-- Content Area -->
      <div class="w-full lg:w-1/2 pr-0 lg:pr-4 flex flex-col justify-center items-center lg:items-start text-center lg:text-left">
        <div class="inline-block bg-white/10 backdrop-blur-md text-white px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest mb-4 sm:mb-6 border border-white/20 self-center lg:self-start">
          Featured Deal
        </div>
        <h3 class="text-white text-2xl sm:text-3xl md:text-4xl font-serif font-black mb-4 sm:mb-6 leading-tight">
          Upgrade Your Kitchen Arsenal
        </h3>
        <div class="flex flex-col gap-1 mb-6 sm:mb-8">
          <p class="text-white/60 text-[10px] font-bold uppercase tracking-widest">Selected Item:</p>
          <p class="text-white font-bold text-base sm:text-lg leading-snug line-clamp-2">{featuredProduct.data.title}</p>
          <p class="text-brand-orange text-xl sm:text-2xl font-black mt-1">${featuredProduct.data.price.toFixed(2)}</p>
        </div>
        <div class="inline-flex items-center gap-2 bg-white text-brand-green font-black py-3 px-6 sm:py-4 sm:px-8 rounded-2xl text-xs sm:text-sm group-hover:bg-brand-orange group-hover:text-white transition-all duration-300 shadow-xl self-center lg:self-start w-full sm:w-auto justify-center">
          Read Full Review
          <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </div>
      </div>
      
      <!-- Image Area -->
      <div class="w-full lg:w-1/2 h-56 sm:h-72 lg:h-full flex items-center justify-center relative group-hover:z-30">
        <!-- Improved background glow/blob -->
        <div class="absolute w-48 h-48 sm:w-64 sm:h-64 bg-white/10 blur-[80px] rounded-full animate-pulse"></div>
        <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent rounded-[3rem] scale-95 translate-x-4 border border-white/5"></div>
        
        <div class="relative z-20 bg-white rounded-3xl p-4 shadow-2xl transform group-hover:scale-105 group-hover:-rotate-2 transition-all duration-700 floating-animation overflow-hidden flex items-center justify-center w-[200px] h-[200px] sm:w-[260px] sm:h-[260px] lg:w-[320px] lg:h-[320px]">
          <img
            src={featuredProduct.data.image}
            alt={featuredProduct.data.title}
            class="max-h-full max-w-full object-contain"
          />
        </div>
      </div>
    </div>
  </a>
</section>

<style>
  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-15px); }
    100% { transform: translateY(0px); }
  }
  .floating-animation {
    animation: float 6s ease-in-out infinite;
  }
</style>