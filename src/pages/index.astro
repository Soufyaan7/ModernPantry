---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import RecipeCard from '../components/RecipeCard.astro';
import AliExpressProductCard from '../components/AliExpressProductCard.astro';
import { getCollection } from 'astro:content';

const allRecipes = await getCollection('recipes');
const products = await getCollection('kitchen-finds');

// Newest featured recipes sorted by date (Fix #4)
const displayRecipes = allRecipes
  .filter(r => r.data.featured)
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 3);

// Fallback: if no featured recipes, just use newest 3
const recipesToShow = displayRecipes.length > 0 ? displayRecipes : allRecipes
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 3);

const displayProducts = products.filter(p => p.data.featured).slice(0, 3);
---

<Layout title="The Modern Pantry - Kitchen Finds & Recipes">
  
  <HeroSection />

  <!-- Main Content Grid -->
  <div class="mt-12">
    
    <!-- Main Full Width -->
    <div class="w-full flex flex-col gap-12">
      
      <!-- Newest Recipes -->
      <section id="newest-recipes">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-6">
          <div>
            <p class="text-sm font-bold uppercase tracking-wider text-brand-orange mb-1">Cook this week</p>
            <h2 class="text-xl font-sans font-bold uppercase tracking-wider">Newest Recipes</h2>
          </div>
          <a href="/recipes" class="text-sm font-bold text-brand-green hover:text-brand-orange transition-colors">View all recipes</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {recipesToShow.map(recipe => (
            <RecipeCard recipe={recipe} />
          ))}
        </div>
      </section>

      <!-- Shop Our Favorites -->
      <section id="shop-favorites">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-6">
          <div>
            <p class="text-sm font-bold uppercase tracking-wider text-brand-orange mb-1">Curated gear</p>
            <h2 class="text-xl font-sans font-bold uppercase tracking-wider">
              Shop Our Favorites <span class="text-sm font-normal normal-case text-gray-500">(powered by AliExpress)</span>
            </h2>
          </div>
          <a href="/kitchen-finds" class="text-sm font-bold text-brand-green hover:text-brand-orange transition-colors">View all finds</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {displayProducts.map(product => (
            <AliExpressProductCard product={product} />
          ))}
        </div>
      </section>

    </div>

  </div>

</Layout>
