---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import AliExpressProductCard from '../../components/AliExpressProductCard.astro';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map(recipe => {
    const cleanSlug = recipe.id.replace(/\.mdx?$/, '');
    return {
      params: { slug: cleanSlug },
      props: { recipe },
    };
  });
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);

// Fetch all kitchen-finds
const allProducts = await getCollection('kitchen-finds');

// Match products based on relatedEquipment
const relatedEquipmentIds = recipe.data.relatedEquipment || [];
const relatedProducts = allProducts.filter(product => 
  relatedEquipmentIds.includes(product.id)
);
---

<Layout title={`${recipe.data.title} - YumCraft`}>
  <article class="max-w-4xl mx-auto mt-10 px-4 md:px-0">
    
    <!-- Recipe Header -->
    <header class="mb-10 text-center">
      <div class="inline-block bg-brand-orange/10 text-brand-orange px-3 py-1 rounded-full text-sm font-bold uppercase tracking-wider mb-4">
        {recipe.data.category}
      </div>
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-brand-text mb-4 leading-tight">
        {recipe.data.title}
      </h1>
      <div class="flex items-center justify-center gap-4 text-sm text-gray-500 font-sans">
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          {recipe.data.time || "30 mins"}
        </span>
        <span>•</span>
        <span class="flex items-center gap-1 text-yellow-500">
          ★ {recipe.data.rating} / 5
        </span>
      </div>
    </header>

    <!-- Main Image -->
    {recipe.data.image && (
      <div class="w-full h-[400px] md:h-[500px] rounded-2xl overflow-hidden mb-12 shadow-md">
        <Image width={1200} height={500} src={recipe.data.image} alt={recipe.data.title} class="w-full h-full object-cover" />
      </div>
    )}

    <!-- Content Area -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      
      <!-- Left Column: Ingredients -->
      <div class="md:col-span-1">
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 sticky top-24">
          <h2 class="text-2xl font-serif font-bold mb-6 border-b border-gray-100 pb-4">Ingredients</h2>
          <ul class="space-y-3 font-sans text-gray-700">
            {recipe.data.ingredients.map((item: string) => (
              <li class="flex items-start gap-3">
                <span class="text-brand-orange mt-1">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                </span>
                <span class="leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Right Column: Directions & Content -->
      <div class="md:col-span-2 prose prose-lg prose-orange max-w-none">
        <p class="text-xl text-gray-600 mb-8 leading-relaxed font-serif italic">
          {recipe.data.description}
        </p>

        <h2 class="text-3xl font-serif font-bold mb-6 text-brand-text">Instructions</h2>
        <div class="space-y-6 mb-12">
          {recipe.data.directions.map((step: string, index: number) => (
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-orange text-white flex items-center justify-center font-bold font-sans">
                {index + 1}
              </div>
              <p class="text-gray-700 leading-relaxed font-sans pt-1 m-0">{step}</p>
            </div>
          ))}
        </div>

        <div class="mt-8 font-sans text-gray-700">
          <Content />
        </div>
      </div>
    </div>

    <!-- Required Equipment Section (Affiliate) -->
    {relatedProducts.length > 0 && (
      <div class="mt-16 pt-12 border-t border-gray-200">
        <div class="text-center mb-10">
          <h2 class="text-3xl font-serif font-bold mb-3 text-brand-text">Tools We Used For This Recipe</h2>
          <p class="text-gray-500 font-sans">Everything you need to recreate this dish perfectly at home.</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedProducts.map(product => (
            <AliExpressProductCard product={product} />
          ))}
        </div>
      </div>
    )}

  </article>
</Layout>
