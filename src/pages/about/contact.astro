---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Contact Us - YumCraft">
  <div class="max-w-4xl mx-auto mt-16 px-4 md:px-0">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-serif font-bold mb-4 text-brand-text">Get In Touch</h1>
      <p class="text-lg text-gray-500 font-sans max-w-2xl mx-auto">
        Have a question about a recipe, a kitchen gadget we reviewed, or just want to say hello? We'd love to hear from you.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Contact Info Sidebar -->
      <div class="md:col-span-1 flex flex-col gap-6">
        <div class="bg-brand-green text-white p-8 rounded-3xl premium-shadow">
          <h3 class="text-xl font-bold uppercase tracking-wider mb-6">Contact Info</h3>
          
          <div class="space-y-6">
            <div>
              <div class="text-xs font-bold text-brand-orange uppercase tracking-wider mb-1">Email</div>
              <a href="mailto:hello@themodernpantry.com" class="hover:text-brand-orange transition-colors">hello@themodernpantry.com</a>
            </div>
            <div>
              <div class="text-xs font-bold text-brand-orange uppercase tracking-wider mb-1">Business Hours</div>
              <p class="text-sm">Mon-Fri: 9AM - 5PM EST</p>
            </div>
            <div>
              <div class="text-xs font-bold text-brand-orange uppercase tracking-wider mb-1">Partnerships</div>
              <a href="mailto:partners@themodernpantry.com" class="hover:text-brand-orange transition-colors text-sm">partners@themodernpantry.com</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="md:col-span-2 bg-white p-8 rounded-3xl shadow-sm border border-gray-100">
        <!-- Honest disclaimer (Fix #6) -->
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-6 text-sm text-amber-800 flex items-start gap-3">
          <svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <span>Clicking <strong>Send</strong> will open your default email client with your message pre-filled. Alternatively, email us directly at <a href="mailto:hello@themodernpantry.com" class="underline font-medium">hello@themodernpantry.com</a>.</span>
        </div>

        <form id="contactForm" class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="firstName" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">First Name</label>
              <input type="text" id="firstName" required class="w-full bg-[#FAFAFA] border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-brand-green focus:border-transparent transition-all" />
            </div>
            <div>
              <label for="lastName" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Last Name</label>
              <input type="text" id="lastName" required class="w-full bg-[#FAFAFA] border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-brand-green focus:border-transparent transition-all" />
            </div>
          </div>

          <div>
            <label for="email" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Your Email Address</label>
            <input type="email" id="email" required class="w-full bg-[#FAFAFA] border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-brand-green focus:border-transparent transition-all" />
          </div>

          <div>
            <label for="subject" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Subject</label>
            <select id="subject" class="w-full bg-[#FAFAFA] border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-brand-green focus:border-transparent transition-all text-gray-700">
              <option value="General Inquiry">General Inquiry</option>
              <option value="Recipe Question">Recipe Question</option>
              <option value="Product Review Question">Product Review Question</option>
              <option value="Partnership Request">Partnership Request</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Message</label>
            <textarea id="message" rows="5" required class="w-full bg-[#FAFAFA] border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-brand-green focus:border-transparent transition-all resize-none"></textarea>
          </div>

          <button type="submit" class="w-full bg-brand-orange hover:bg-orange-700 text-white font-bold uppercase tracking-wider py-4 rounded-xl transition-colors shadow-md">
            Send via Email Client
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Fix #6: Build a mailto: link from the form fields and open it — no fake success
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('contactForm');
    if (!form) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const firstName = (document.getElementById('firstName') as HTMLInputElement)?.value.trim();
      const lastName  = (document.getElementById('lastName') as HTMLInputElement)?.value.trim();
      const email     = (document.getElementById('email') as HTMLInputElement)?.value.trim();
      const subject   = (document.getElementById('subject') as HTMLSelectElement)?.value;
      const message   = (document.getElementById('message') as HTMLTextAreaElement)?.value.trim();

      const body = `From: ${firstName} ${lastName} (${email})\n\n${message}`;
      const mailto = `mailto:hello@themodernpantry.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

      window.location.href = mailto;
    });
  });
</script>
