---
import Layout from '../../layouts/Layout.astro';
import AliExpressProductCard from '../../components/AliExpressProductCard.astro';
import { getCollection } from 'astro:content';

const products = (await getCollection('kitchen-finds')).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return a.data.price - b.data.price;
});

const shippingOptions = [...new Set(products.map(product => product.data.shippingType))].sort();
---

<Layout title="Kitchen Finds - The Modern Pantry">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 mt-10 md:mt-12">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-8">
      <div class="max-w-2xl">
        <p class="text-sm font-bold uppercase tracking-wider text-brand-orange mb-2">Tested picks</p>
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-brand-text mb-4">Kitchen Finds</h1>
        <p class="text-lg text-gray-500 font-sans">
          Browse practical cooking tools and product reviews before you leave for AliExpress.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 w-full lg:w-auto">
        <label class="block">
          <span class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">Shipping</span>
          <select id="shipping-filter" class="w-full lg:w-48 rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm font-medium text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-green">
            <option value="all">All shipping</option>
            {shippingOptions.map(option => (
              <option value={option}>{option}</option>
            ))}
          </select>
        </label>

        <label class="block">
          <span class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">Sort by</span>
          <select id="sort-products" class="w-full lg:w-48 rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm font-medium text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-green">
            <option value="featured">Featured first</option>
            <option value="price-asc">Price: low to high</option>
            <option value="price-desc">Price: high to low</option>
            <option value="newest">Newest</option>
          </select>
        </label>
      </div>
    </div>

    <div class="mb-6 flex items-center justify-between gap-4">
      <p id="product-count" class="text-sm font-medium text-gray-500">{products.length} finds</p>
      <a href="/about/affiliate-disclosure" class="text-sm font-bold text-brand-green hover:text-brand-orange transition-colors">Affiliate disclosure</a>
    </div>

    <div id="products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {products.map(product => (
        <div
          class="product-item"
          data-shipping={product.data.shippingType}
          data-featured={product.data.featured ? '1' : '0'}
          data-price={product.data.price}
          data-date={product.data.publishDate.toISOString()}
        >
          <AliExpressProductCard product={product} />
        </div>
      ))}
    </div>

    <div id="empty-products" class="hidden text-center py-20">
      <p class="text-xl text-gray-500 font-serif">No kitchen finds match this filter.</p>
    </div>
  </div>
</Layout>

<script>
  function initProductControls() {
    const shippingFilter = document.getElementById('shipping-filter');
    const sortProducts = document.getElementById('sort-products');
    const grid = document.getElementById('products-grid');
    const count = document.getElementById('product-count');
    const emptyState = document.getElementById('empty-products');

    if (!shippingFilter || !sortProducts || !grid || !count || shippingFilter.dataset.ready === 'true') return;
    shippingFilter.dataset.ready = 'true';

    const applyControls = () => {
      const selectedShipping = shippingFilter.value;
      const sortMode = sortProducts.value;
      const items = Array.from(grid.querySelectorAll('.product-item'));

      items.sort((a, b) => {
        const aPrice = Number(a.getAttribute('data-price'));
        const bPrice = Number(b.getAttribute('data-price'));
        const aFeatured = Number(a.getAttribute('data-featured'));
        const bFeatured = Number(b.getAttribute('data-featured'));
        const aDate = new Date(a.getAttribute('data-date')).getTime();
        const bDate = new Date(b.getAttribute('data-date')).getTime();

        if (sortMode === 'price-asc') return aPrice - bPrice;
        if (sortMode === 'price-desc') return bPrice - aPrice;
        if (sortMode === 'newest') return bDate - aDate;
        return bFeatured - aFeatured || aPrice - bPrice;
      });

      let visibleCount = 0;
      items.forEach(item => {
        const matchesShipping = selectedShipping === 'all' || item.getAttribute('data-shipping') === selectedShipping;
        item.classList.toggle('hidden', !matchesShipping);
        grid.appendChild(item);
        if (matchesShipping) visibleCount++;
      });

      count.textContent = `${visibleCount} ${visibleCount === 1 ? 'find' : 'finds'}`;
      emptyState.classList.toggle('hidden', visibleCount !== 0);
    };

    shippingFilter.addEventListener('change', applyControls);
    sortProducts.addEventListener('change', applyControls);
  }

  document.addEventListener('astro:page-load', initProductControls);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProductControls);
  } else {
    initProductControls();
  }
</script>
