---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Countdown from '../../components/Countdown.astro';

export async function getStaticPaths() {
  const products = await getCollection('kitchen-finds');
  return products.map(product => {
    const slug = product.id.replace(/\.mdx?$/, '');
    return {
      params: { slug },
      props: { product },
    };
  });
}

const { product } = Astro.props;
const { Content } = await render(product);
const { 
  title, description, price, originalPrice, 
  features, affiliateLink, shippingType, 
  image, images, badge, scores, 
  pros, cons, reviews, faq 
} = product.data;

const avgRating = scores 
  ? (scores.quality + scores.value + scores.easeOfUse + scores.design) / 4 
  : 5;

const discount = originalPrice 
  ? Math.round(((originalPrice - price) / originalPrice) * 100) 
  : 0;
---

<Layout title={`${title} - Le Savoury Review`}>
  <div class="max-w-6xl mx-auto px-4 py-8">
    
    <!-- 1. Breadcrumb -->
    <nav class="flex mb-8 text-sm font-medium text-gray-500" aria-label="Breadcrumb">
      <ol class="flex items-center space-x-2">
        <li><a href="/" class="hover:text-brand-orange transition-colors">Home</a></li>
        <li>
          <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
        </li>
        <li><a href="/kitchen-finds" class="hover:text-brand-orange transition-colors">Kitchen Finds</a></li>
        <li>
          <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
        </li>
        <li class="text-brand-text truncate max-w-[200px] md:max-w-none">{title}</li>
      </ol>
    </nav>

    <!-- 2. Hero Section -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16 bg-white p-6 md:p-10 rounded-[2.5rem] shadow-sm border border-gray-100">
      <!-- Gallery -->
      <div class="space-y-4">
        <div class="relative aspect-square rounded-3xl bg-gray-50 overflow-hidden border border-gray-100 group">
          {badge && (
            <div class="absolute top-4 right-4 bg-brand-orange text-white px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider z-10 shadow-lg">
              {badge}
            </div>
          )}
          {discount > 0 && (
            <div class="absolute top-4 left-4 bg-red-500 text-white px-3 py-1.5 rounded-xl text-sm font-black z-10 shadow-lg animate-pulse">
              -{discount}%
            </div>
          )}
          <img 
            id="main-image" 
            src={image || "https://images.unsplash.com/photo-1593618998160-e34014e67546?w=400&q=80"} 
            alt={title} 
            class="w-full h-full object-contain p-8 transition-all duration-500 hover:scale-105"
          />
        </div>
        
        {images && images.length > 1 && (
          <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-hide">
            {images.map((img, index) => (
              <button class="thumbnail-btn min-w-[80px] h-[80px] border-2 border-transparent rounded-2xl overflow-hidden bg-gray-50 flex-shrink-0 transition-all hover:border-brand-green/50 hover:shadow-md" data-src={img}>
                <img src={img} alt={`${title} view ${index + 1}`} class="w-full h-full object-cover" />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- Info -->
      <div class="flex flex-col justify-center">
        <div class="flex items-center gap-2 mb-4">
          <div class="flex text-yellow-400">
            {[...Array(5)].map((_, i) => (
              <svg class={`w-5 h-5 ${i < Math.round(avgRating) ? 'fill-current' : 'fill-gray-200'}`} viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <span class="text-sm font-bold text-gray-500">{avgRating.toFixed(1)} / 5 ({product.data.reviewCount?.toLocaleString()} Reviews)</span>
        </div>

        <h1 class="text-4xl md:text-5xl font-serif font-black text-brand-text mb-4 leading-tight">
          {title}
        </h1>
        
        <p class="text-lg text-gray-600 mb-8 font-sans leading-relaxed">
          {description}
        </p>

        <div class="flex items-baseline gap-3 mb-8">
          <span class="text-4xl font-black text-brand-orange">${price.toFixed(2)}</span>
          {originalPrice && (
            <span class="text-xl text-gray-400 line-through font-medium">${originalPrice.toFixed(2)}</span>
          )}
          <span class="text-sm font-bold text-brand-green uppercase tracking-widest ml-auto">{shippingType}</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
          {features.slice(0, 4).map((feature: string) => (
            <div class="flex items-center gap-3 bg-brand-bg/30 p-3 rounded-2xl border border-brand-bg">
              <div class="bg-brand-green/10 p-1.5 rounded-full text-brand-green">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
              </div>
              <span class="text-sm font-semibold text-gray-700">{feature}</span>
            </div>
          ))}
        </div>

        <!-- Flash Sale Urgency Countdown -->
        <div class="bg-orange-50/50 border border-orange-100 p-4 rounded-[1.5rem] flex flex-col sm:flex-row gap-4 items-center justify-between mb-8 shadow-sm">
          <div class="flex items-center gap-2.5">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
            </span>
            <span class="text-xs font-black text-brand-orange uppercase tracking-wider">AliExpress Flash Sale Deal</span>
          </div>
          <Countdown />
        </div>

        <a href={affiliateLink} target="_blank" rel="noopener noreferrer" class="group relative w-full bg-brand-orange hover:bg-brand-orange/90 text-white font-black py-5 rounded-[2rem] transition-all text-center shadow-xl shadow-brand-orange/20 hover:shadow-2xl hover:shadow-brand-orange/30 flex items-center justify-center gap-3 text-lg overflow-hidden">
          <span class="relative z-10">Get the Best Price on AliExpress</span>
          <svg class="relative z-10 w-6 h-6 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          <div class="absolute inset-0 bg-gradient-to-r from-white/0 via-white/20 to-white/0 -translate-x-full group-hover:translate-x-full transition-transform duration-1000"></div>
        </a>
      </div>
    </div>

    <!-- 3. Scores Details -->
    {scores && (
      <div class="mb-16">
        <h2 class="text-3xl font-serif font-black text-center mb-10 text-brand-text">Performance Analysis</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          {Object.entries(scores).map(([key, val]) => (
            <div class="bg-white p-6 rounded-[2rem] border border-gray-100 shadow-sm flex flex-col items-center text-center group hover:border-brand-green/30 transition-all">
              <div class="relative w-24 h-24 mb-4">
                <svg class="w-full h-full -rotate-90" viewBox="0 0 36 36">
                  <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#F3F4F6" stroke-width="3" />
                  <path 
                    d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" 
                    fill="none" 
                    stroke="var(--brand-green)" 
                    stroke-width="3" 
                    stroke-dasharray={`${(val as number) * 20}, 100`} 
                    class="transition-all duration-1000 ease-out"
                  />
                </svg>
                <div class="absolute inset-0 flex items-center justify-center font-black text-2xl text-brand-text">
                  {val}
                </div>
              </div>
              <span class="font-bold text-gray-500 uppercase tracking-widest text-xs">{key.replace(/([A-Z])/g, ' $1')}</span>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- 4. Pros & Cons -->
    {(pros || cons) && (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        {pros && pros.length > 0 && (
          <div class="bg-green-50/50 p-8 rounded-[2.5rem] border border-green-100">
            <h3 class="flex items-center gap-3 text-xl font-black text-green-800 mb-6 uppercase tracking-wider">
              <div class="bg-green-100 p-1.5 rounded-full"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg></div>
              Pros
            </h3>
            <ul class="space-y-4">
              {pros.map((pro: string) => (
                <li class="flex items-start gap-3 text-green-900 font-semibold leading-tight">
                  <span class="text-green-500 mt-1">•</span>
                  {pro}
                </li>
              ))}
            </ul>
          </div>
        )}
        {cons && cons.length > 0 && (
          <div class="bg-red-50/50 p-8 rounded-[2.5rem] border border-red-100">
            <h3 class="flex items-center gap-3 text-xl font-black text-red-800 mb-6 uppercase tracking-wider">
              <div class="bg-red-100 p-1.5 rounded-full"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path></svg></div>
              Cons
            </h3>
            <ul class="space-y-4">
              {cons.map((con: string) => (
                <li class="flex items-start gap-3 text-red-900 font-semibold leading-tight">
                  <span class="text-red-400 mt-1">•</span>
                  {con}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}

    <!-- 5. Full Review -->
    <div class="mb-16">
      <div class="bg-white p-8 md:p-16 rounded-[3rem] shadow-sm border border-gray-100 prose prose-lg prose-orange max-w-none">
        <h2 class="text-4xl font-serif font-black text-brand-text mb-12 text-center not-prose uppercase tracking-tighter">The Full Verdict</h2>
        <Content />
      </div>
    </div>



    <!-- 7. FAQ -->
    {faq && faq.length > 0 && (
      <div class="mb-16 max-w-3xl mx-auto">
        <h2 class="text-3xl font-serif font-black text-brand-text text-center mb-10">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faq.map((item, index) => (
            <div class="faq-item group">
              <button class="faq-toggle w-full flex items-center justify-between p-6 bg-white rounded-[1.5rem] border border-gray-100 shadow-sm transition-all hover:border-brand-orange/30">
                <span class="text-left font-black text-brand-text pr-8">{item.question}</span>
                <svg class="w-6 h-6 text-brand-orange transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              <div class="faq-content overflow-hidden max-h-0 transition-all duration-300 ease-in-out">
                <div class="p-8 text-gray-600 font-medium leading-relaxed bg-brand-bg/20 rounded-b-[1.5rem] -mt-4 pt-10 border-x border-b border-gray-50">
                  {item.answer}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- 8. Final CTA -->
    <div class="bg-brand-text rounded-[3rem] p-10 md:p-16 text-center text-white relative overflow-hidden group">
      <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] pointer-events-none"></div>
      <div class="relative z-10">
        <h2 class="text-3xl md:text-5xl font-serif font-black mb-6 leading-tight">Ready to upgrade your pantry?</h2>
        <p class="text-xl text-gray-300 mb-10 font-bold">Don't miss the current flash sale on AliExpress.</p>
        <a href={affiliateLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 bg-brand-orange hover:bg-white hover:text-brand-orange text-white font-black px-8 py-4 sm:px-10 sm:py-5 rounded-full transition-all duration-300 text-base sm:text-xl shadow-2xl hover:scale-105 w-full sm:w-auto">
          <span>Get the Best Price Now</span>
          <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </a>
      </div>
    </div>

  </div>
</Layout>

<style>
  :root {
    --brand-green: #2D5A27;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  function initGallery() {
    const mainImage = document.getElementById('main-image') as HTMLImageElement;
    const thumbButtons = document.querySelectorAll('.thumbnail-btn');

    if (!mainImage || thumbButtons.length === 0) return;
    
    // Prevent duplicate binding
    if (mainImage.getAttribute('data-gallery-bound') === 'true') return;
    mainImage.setAttribute('data-gallery-bound', 'true');

    // Set first thumbnail as active
    thumbButtons[0].classList.add('border-brand-green', 'shadow-md');

    thumbButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const newSrc = btn.getAttribute('data-src');
        if (!newSrc || mainImage.src === newSrc) return;

        mainImage.style.opacity = '0.5';
        
        thumbButtons.forEach(b => b.classList.remove('border-brand-green', 'shadow-md'));
        btn.classList.add('border-brand-green', 'shadow-md');

        setTimeout(() => {
          mainImage.src = newSrc;
          mainImage.style.opacity = '1';
        }, 200);
      });
    });
  }

  function initFAQ() {
    const toggles = document.querySelectorAll('.faq-toggle');
    
    toggles.forEach(toggle => {
      // Prevent duplicate binding
      if (toggle.getAttribute('data-faq-bound') === 'true') return;
      toggle.setAttribute('data-faq-bound', 'true');

      toggle.addEventListener('click', () => {
        const item = toggle.closest('.faq-item');
        const content = item?.querySelector('.faq-content') as HTMLElement;
        const icon = toggle.querySelector('svg');
        
        // Close others
        document.querySelectorAll('.faq-item').forEach(otherItem => {
          if (otherItem !== item) {
            const otherContent = otherItem.querySelector('.faq-content') as HTMLElement;
            const otherIcon = otherItem.querySelector('.faq-toggle svg');
            otherContent.style.maxHeight = '0px';
            otherIcon?.classList.remove('rotate-180');
          }
        });

        // Toggle current
        if (content.style.maxHeight && content.style.maxHeight !== '0px') {
          content.style.maxHeight = '0px';
          icon?.classList.remove('rotate-180');
        } else {
          content.style.maxHeight = content.scrollHeight + 'px';
          icon?.classList.add('rotate-180');
        }
      });
    });
  }

  document.addEventListener('astro:page-load', () => {
    initGallery();
    initFAQ();
  });
</script>
