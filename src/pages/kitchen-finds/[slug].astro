---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const products = await getCollection('kitchen-finds');
  return products.map(product => {
    const slug = product.id.replace(/\.mdx?$/, '');
    return {
      params: { slug },
      props: { product },
    };
  });
}

const { product } = Astro.props;
const { Content } = await render(product);
---

<Layout title={`${product.data.title} - The Modern Pantry Review`}>
  <article class="max-w-4xl mx-auto mt-10 px-4 md:px-0">
    
    <div class="mb-6">
      <a href="/products" class="text-brand-green font-bold text-sm hover:underline flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Back to Kitchen Finds
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 bg-white p-8 rounded-3xl shadow-sm border border-gray-100 mb-12">
      <!-- Product Images Gallery -->
      <div class="flex flex-col gap-4">
        <div class="relative w-full aspect-square bg-gray-50 rounded-2xl flex items-center justify-center p-6 overflow-hidden">
          <img id="main-image" src={product.data.image || "https://images.unsplash.com/photo-1593618998160-e34014e67546?w=400&q=80"} alt={product.data.title} class="max-h-full max-w-full object-contain drop-shadow-lg transition-opacity duration-300" />
          <div class="absolute top-4 left-4 bg-brand-orange text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider shadow-md">
            Editor's Choice
          </div>
        </div>
        
        {product.data.images && product.data.images.length > 1 && (
          <div class="flex gap-2 overflow-x-auto pb-2 scrollbar-hide">
            {product.data.images.map((img, index) => (
              <button class="thumbnail-btn min-w-[80px] h-[80px] border-2 border-transparent rounded-xl overflow-hidden bg-gray-50 flex-shrink-0 transition-all hover:border-brand-green/50" data-src={img}>
                <img src={img} alt={`${product.data.title} view ${index + 1}`} class="w-full h-full object-cover" />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- Product Info -->
      <div class="flex flex-col justify-center">
        <h1 class="text-3xl md:text-4xl font-serif font-bold text-brand-text mb-4 leading-tight">
          {product.data.title}
        </h1>
        
        <p class="text-lg text-gray-600 mb-6 font-sans">
          {product.data.description}
        </p>

        <div class="mb-6">
          <span class="text-3xl font-bold text-brand-text">${product.data.price}</span>
          <span class="text-sm text-gray-500 ml-2">via AliExpress</span>
        </div>

        <div class="bg-[#EBE5D9]/50 rounded-xl p-6 mb-8 border border-[#EBE5D9]">
          <h3 class="font-bold uppercase tracking-wider text-brand-text text-sm mb-4">Why we love it:</h3>
          <ul class="space-y-3">
            {product.data.features.map((feature: string) => (
              <li class="flex items-start gap-3">
                <span class="text-brand-green mt-0.5">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
                </span>
                <span class="text-gray-700 font-medium">{feature}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Call to Action -->
        <a href={product.data.affiliateLink} target="_blank" rel="noopener noreferrer" class="w-full bg-brand-orange hover:bg-orange-700 text-white font-bold py-4 rounded-xl transition-all uppercase tracking-wider text-center shadow-lg hover:shadow-xl flex items-center justify-center gap-2">
          Buy on AliExpress
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
        <div class="text-center mt-3 text-xs text-gray-500 flex items-center justify-center gap-1">
          <svg class="w-4 h-4 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          {product.data.shippingType}
        </div>
      </div>
    </div>

    <!-- Detailed Review Content (Markdown) -->
    <div class="prose prose-lg prose-orange max-w-none bg-white p-8 md:p-12 rounded-3xl shadow-sm border border-gray-100 mb-16">
      <h2 class="text-3xl font-serif font-bold mb-8 border-b border-gray-100 pb-4">Our Full Review</h2>
      <Content />
    </div>
  </article>
</Layout>

<script>
  function initGallery() {
    const mainImage = document.getElementById('main-image') as HTMLImageElement;
    const thumbButtons = document.querySelectorAll('.thumbnail-btn');

    if (!mainImage || thumbButtons.length === 0) return;

    // Set first thumbnail as active
    thumbButtons[0].classList.add('border-brand-green');

    thumbButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const newSrc = btn.getAttribute('data-src');
        if (!newSrc || mainImage.src === newSrc) return;

        // Fade out
        mainImage.style.opacity = '0';
        
        // Update active state
        thumbButtons.forEach(b => b.classList.remove('border-brand-green'));
        btn.classList.add('border-brand-green');

        setTimeout(() => {
          mainImage.src = newSrc;
          // Fade in
          mainImage.style.opacity = '1';
        }, 300);
      });
    });
  }

  document.addEventListener('astro:page-load', initGallery);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGallery);
  } else {
    initGallery();
  }
</script>
