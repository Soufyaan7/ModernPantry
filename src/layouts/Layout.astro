---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "YumCraft - Kitchen Finds & Recipes" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-brand-bg text-brand-text font-sans antialiased flex flex-col min-h-screen">
    
    <Header />

    <main class="flex-grow max-w-[1400px] mx-auto w-full pb-16">
      <slot />
    </main>

    <Footer />
    
    <!-- L'activation de Vercel Analytics se fait ici 👇 -->
    <Analytics />
    <SpeedInsights/>
  </body>
</html>